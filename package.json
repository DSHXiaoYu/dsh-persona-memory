  "keywords": [
    "dsh",
    "dsh-plugin",
    "memory",
    "persona",
    "long-term-memory",
    "agent"
  ],
  "author": "DSHXiaoYu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DSHXiaoYu/dsh-persona-memory.git"
  },
  "homepage": "https://github.com/DSHXiaoYu/dsh-persona-memory#readme",
  "bugs": {
